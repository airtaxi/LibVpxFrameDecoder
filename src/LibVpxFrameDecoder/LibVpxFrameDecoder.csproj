<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Platforms>AnyCPU;x64;ARM64</Platforms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- NuGet metadata. The native libraries of every native/<rid> folder are packed as runtimes/<rid>/native assets. -->
	<PropertyGroup>
		<PackageId>LibVpxFrameDecoder</PackageId>
		<Version>1.0.1</Version>
		<Authors>Howon Lee</Authors>
		<Description>WebM (VP8/VP9) frame decoder for .NET with alpha support, built on libvpx and libyuv.</Description>
		<PackageTags>webm;vp8;vp9;libvpx;libyuv;video;alpha</PackageTags>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/airtaxi/LibVpxFrameDecoder</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup>
		<NativeLibraryRoot>$(MSBuildThisFileDirectory)..\..\native\</NativeLibraryRoot>
	</PropertyGroup>

	<!-- Copies every native library that exists under native/<rid>/ into runtimes/<rid>/native/ so the resolver
	     in Interop/NativeLibraryResolver.cs can follow the runtime identifier of the process. -->
	<ItemGroup>
		<NativeLibraryFile Include="$(NativeLibraryRoot)**\vpx.dll;$(NativeLibraryRoot)**\libyuv.dll;$(NativeLibraryRoot)**\libvpx.so;$(NativeLibraryRoot)**\libyuv.so;$(NativeLibraryRoot)**\libvpx.dylib;$(NativeLibraryRoot)**\libyuv.dylib" />
		<Content Include="@(NativeLibraryFile)" Link="runtimes\%(RecursiveDir)native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="false" Visible="false" />
	</ItemGroup>

	<!-- Static libraries for iOS and Mac Catalyst. They are built by scripts/build-native-apple-static.sh and are
	     linked into an app by buildTransitive/LibVpxFrameDecoder.targets. -->
	<ItemGroup>
		<AppleStaticLibraryFile Include="$(NativeLibraryRoot)apple\**\*.a" />
	</ItemGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddNativeLibrariesToPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!-- NuGet drops files outside the project directory, so the native libraries are staged under obj/ first and
	     then packed: the dynamic libraries as runtimes/<rid>/native/<file> entries and the Apple static libraries
	     as static/<folder>/<file> entries. -->
	<Target Name="AddNativeLibrariesToPackage">
		<RemoveDir Directories="$(IntermediateOutputPath)nuget" />
		<ItemGroup>
			<NativeLibraryStageFile Include="@(NativeLibraryFile)" StagedPath="$(IntermediateOutputPath)nuget\runtimes\%(RecursiveDir)native\%(Filename)%(Extension)" />
			<AppleStaticLibraryStageFile Include="@(AppleStaticLibraryFile)" StagedPath="$(IntermediateOutputPath)nuget\static\%(RecursiveDir)%(Filename)%(Extension)" />
		</ItemGroup>
		<Copy SourceFiles="@(NativeLibraryStageFile)" DestinationFiles="@(NativeLibraryStageFile->'%(StagedPath)')" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(AppleStaticLibraryStageFile)" DestinationFiles="@(AppleStaticLibraryStageFile->'%(StagedPath)')" SkipUnchangedFiles="true" Condition="'@(AppleStaticLibraryStageFile)' != ''" />
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(IntermediateOutputPath)nuget\runtimes\**\*.*" PackagePath="runtimes/" Visible="false" />
			<TfmSpecificPackageFile Include="$(IntermediateOutputPath)nuget\static\**\*.*" PackagePath="static/" Visible="false" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)..\..\LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<!-- The native binaries ship with their license and patent texts, as the BSD style licenses require. -->
		<None Include="$(MSBuildThisFileDirectory)..\..\native\libvpx-LICENSE.txt" Pack="true" PackagePath="native/" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\..\native\libvpx-PATENTS.txt" Pack="true" PackagePath="native/" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\..\native\libyuv-LICENSE.txt" Pack="true" PackagePath="native/" Visible="false" />
		<None Include="$(MSBuildThisFileDirectory)..\..\native\libyuv-PATENTS.txt" Pack="true" PackagePath="native/" Visible="false" />
		<!-- Links the static Apple libraries into the apps that consume the package. -->
		<None Include="$(MSBuildThisFileDirectory)..\..\buildTransitive\LibVpxFrameDecoder.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
	</ItemGroup>

</Project>
