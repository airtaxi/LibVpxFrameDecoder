<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-maccatalyst</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- The Mac Catalyst 27 SDK rejects a deployment target below 17.0. The library itself still targets 15.0. -->
		<SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The workflow passes the version of the package it just packed. The default points at the published package. -->
		<LibVpxFrameDecoderProbeVersion Condition="'$(LibVpxFrameDecoderProbeVersion)' == ''">1.0.3</LibVpxFrameDecoderProbeVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LibVpxFrameDecoder" Version="$(LibVpxFrameDecoderProbeVersion)" />
	</ItemGroup>

</Project>
